rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Imágenes de noticias: cualquier usuario autenticado puede subir, todos pueden leer
    match /noticias/{filename} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Imágenes de productos de la tienda: solo admins pueden subir, todos pueden leer
    match /tienda/{filename} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
